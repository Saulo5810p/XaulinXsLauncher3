<?xml version="1.0" encoding="utf-8"?>
<!--
     XaulinXs Customizations - Fase 1 (novo popup de app).
     Fundo circular com ripple por trás do ícone grande e editável no
     topo do popup de app. Na Fase 4 o toque aqui vai abrir o seletor
     de imagem/galeria/DocumentsUI para trocar o ícone.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF"/>
        </shape>
    </item>
</ripple>
