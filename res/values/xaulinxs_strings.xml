    <string name="xaulinxs_themed_icons_title">Ícones temáticos</string>
    <string name="xaulinxs_themed_icons_summary">Colorir os ícones com base no papel de parede (Material You)</string>
    <string name="xaulinxs_themed_scrim_title">Fundo desfocado no menu de apps</string>
    <string name="xaulinxs_themed_scrim_summary">Aplica um efeito de vidro fosco temático ao papel de parede na tela de apps</string>
    <string name="xaulinxs_icon_scale_title">Tamanho dos ícones</string>
    <string name="xaulinxs_icon_scale_summary">Aumenta o tamanho dos ícones até 200% (valores altos podem sobrepor ícones vizinhos)</string>
    <string name="xaulinxs_icon_labels_title">Ocultar labels dos ícones</string>
    <string name="xaulinxs_icon_labels_summary">Esconde o texto abaixo dos ícones na tela inicial, gaveta de apps e pastas</string>
    <string name="xaulinxs_icon_opacity_title">Transparência dos ícones</string>
    <string name="xaulinxs_icon_opacity_summary">Ajusta a opacidade dos ícones de 0% a 100%</string>
    <string name="xaulinxs_scrim_opacity_title">Transparência do véu temático (com blur)</string>
    <string name="xaulinxs_scrim_opacity_summary">Ajusta a opacidade do véu colorido do wallpaper atrás da gaveta de apps — só tem efeito com "Fundo desfocado no menu de apps" ativado</string>
    <string name="xaulinxs_allapps_transparency_enabled_title">Transparência do menu de apps (sem blur)</string>
    <string name="xaulinxs_allapps_transparency_enabled_summary">Mostra a tela inicial por trás da gaveta de apps, sem nenhum desfoque — só funciona com "Fundo desfocado no menu de apps" DESATIVADO</string>
    <string name="xaulinxs_allapps_transparency_percent_title">Nível de transparência</string>
    <string name="xaulinxs_allapps_transparency_percent_summary" formatted="false">0% = totalmente transparente (mostra a tela inicial); 100% = opaco</string>
    <string name="xaulinxs_popup_blur_title">Blur nos balões de contexto</string>
    <string name="xaulinxs_popup_blur_summary">Desfoca o fundo atrás do menu que abre ao segurar o dedo num ícone (independente do blur do menu de apps)</string>
    <string name="xaulinxs_widget_blur_title">Desfoque dos widgets</string>
    <string name="xaulinxs_widget_blur_summary">Deixa a aparência de cada widget embaçada (0 = nítido)</string>
    <string name="xaulinxs_gyro_tilt_title">Inclinação por giroscópio</string>
    <string name="xaulinxs_gyro_tilt_summary">Inclina a tela inicial (efeito coverflow) conforme você move o aparelho na mão</string>
    <string name="xaulinxs_manual_color_enabled_title">Usar cor manual</string>
    <string name="xaulinxs_manual_color_enabled_summary">Usa uma cor fixa escolhida por você em vez da cor do papel de parede</string>
    <string name="xaulinxs_manual_color_picker_title">Escolher cor (hex)</string>
    <string name="xaulinxs_manual_color_save">Salvar</string>
    <string name="xaulinxs_legacy_icon_bg_shadow_title">Remover fundo/sombra dos ícones antigos</string>
    <string name="xaulinxs_legacy_icon_bg_shadow_summary">Apps antigos sem ícone adaptativo ganham hoje um fundo branco sintético + sombra; ativando isso, o fundo vira transparente e a sombra some (ícones adaptativos modernos não são afetados)</string>
    <string name="xaulinxs_balloon_color_enabled_title">Cor customizada dos balões</string>
    <string name="xaulinxs_balloon_color_enabled_summary">Desligado (padrão): a cor dos balões segue a cor extraída do papel de parede. Ligado: usa a cor escolhida abaixo</string>
    <string name="xaulinxs_balloon_color_picker_title">Cor dos balões (hex)</string>
    <string name="xaulinxs_change_wallpaper_title">Trocar wallpaper</string>
    <string name="xaulinxs_change_wallpaper_summary">Escolhe uma imagem para o fundo do R\'s Home3. Como você está trocando por dentro do launcher, o wallpaper do sistema também muda junto</string>
    <string name="xaulinxs_grid_size_title">Tamanho da grade</string>
    <string name="xaulinxs_grid_size_summary">Escolhe quantas colunas e linhas de ícones cabem no Menu de aplicativo e na Área de trabalho, de 2x2 até 10x10 (as duas telas usam a mesma grade)</string>
    <string name="xaulinxs_folder_color_enabled_title">Cor customizada da pasta</string>
    <string name="xaulinxs_folder_color_enabled_summary">Desligado (padrão): usa a cor de tema padrão. Ligado: usa a cor escolhida abaixo</string>
    <string name="xaulinxs_folder_color_picker_title">Cor da pasta (hex)</string>
    <string name="xaulinxs_folder_transparency_title">Transparência da pasta</string>
    <string name="xaulinxs_folder_transparency_summary" formatted="false">100% = opaco (padrão), 0% = totalmente transparente</string>
    <string name="xaulinxs_folder_size_title">Tamanho da pasta</string>
    <string name="xaulinxs_folder_size_summary" formatted="false">100% = tamanho padrão. Mínimo de 30% para continuar fácil de tocar</string>
    <string name="xaulinxs_workspace_blur_title">Desfoque da tela inicial</string>
    <string name="xaulinxs_workspace_blur_summary">0% = sem desfoque (padrão). Desfoca o wallpaper próprio do launcher atrás dos ícones (precisa de Android 12+)</string>
